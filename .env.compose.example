# Copy this file to .env before running Docker Compose.
# Use URL-safe characters for CODEEVO_POSTGRES_PASSWORD because it is embedded in a URL.
CODEEVO_POSTGRES_PASSWORD=replace-with-a-long-url-safe-password
CODEEVO_AUTH_SECRET=replace-with-at-least-32-random-bytes
CODEEVO_BOOTSTRAP_ADMIN_USERNAME=admin
CODEEVO_BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-admin-password

# The default binds only to localhost. Put a TLS reverse proxy in front for public access.
CODEEVO_BIND_ADDRESS=127.0.0.1
CODEEVO_PORT=8080
CODEEVO_PUBLIC_BASE_URL=http://127.0.0.1:8080
CODEEVO_IMAGE_TAG=1.0.0

# Short-lived, isolated read-only experience for public portfolio deployments.
CODEEVO_GUEST_DEMO_ENABLED=true
CODEEVO_GUEST_DEMO_TENANT_ID=public-demo
CODEEVO_GUEST_DEMO_TTL_SECONDS=300

# Offline local rules require no API key. To use DeepSeek, change the provider and set a new key.
CODEEVO_LLM_PROVIDER=local
CODEEVO_DEEPSEEK_API_KEY=

CODEEVO_LOG_FORMAT=json
CODEEVO_LOG_LEVEL=INFO
CODEEVO_DATABASE_AUTO_MIGRATE=true
CODEEVO_AUTO_POST_REVIEW=false

# Host-side ops scripts. Store webhook values outside source control.
CODEEVO_BACKUP_DIR=./backups
CODEEVO_BACKUP_RETENTION_DAYS=14
CODEEVO_DISK_WARNING_PERCENT=80
CODEEVO_DISK_CRITICAL_PERCENT=90

# Optional build-only mirror for networks that cannot reliably access official PyPI.
# CODEEVO_PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple

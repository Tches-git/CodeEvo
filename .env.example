CODEEVO_HOST=127.0.0.1
CODEEVO_PORT=8080
CODEEVO_DB_PATH=codeevo.db
CODEEVO_MAX_DIFF_BYTES=1048576
CODEEVO_MAX_STEPS=8
CODEEVO_TIMEOUT_SECONDS=120

# Login is disabled by default for local use. Enable it before exposing the service.
CODEEVO_AUTH_REQUIRED=false
CODEEVO_AUTH_SECRET=
CODEEVO_BOOTSTRAP_ADMIN_USERNAME=
CODEEVO_BOOTSTRAP_ADMIN_PASSWORD=
CODEEVO_DEFAULT_TENANT_ID=default
CODEEVO_SESSION_TTL_SECONDS=3600
CODEEVO_LOGIN_MAX_ATTEMPTS=5
CODEEVO_LOGIN_WINDOW_SECONDS=300
CODEEVO_LOGIN_LOCKOUT_SECONDS=300

# Optional public portfolio mode. Requires CODEEVO_AUTH_REQUIRED=true.
CODEEVO_GUEST_DEMO_ENABLED=false
CODEEVO_GUEST_DEMO_TENANT_ID=public-demo
CODEEVO_GUEST_DEMO_TTL_SECONDS=300
CODEEVO_DEMO_MAX_DIFF_BYTES=98304
CODEEVO_DEMO_RATE_LIMIT=5
CODEEVO_DEMO_RATE_WINDOW_SECONDS=3600

# LLM provider: local | deepseek | openrouter-deepseek-free | openrouter-free | custom
# local keeps the deterministic rule-only reviewer.
CODEEVO_LLM_PROVIDER=local

# Official DeepSeek (paid API; model defaults to the stable deepseek-chat alias)
CODEEVO_DEEPSEEK_API_KEY=

# OpenRouter free presets (API key required; low rate limits and availability may vary)
CODEEVO_OPENROUTER_API_KEY=
CODEEVO_OPENROUTER_SITE_URL=
CODEEVO_OPENROUTER_APP_NAME=CodeEvo

# Custom OpenAI-compatible Chat Completions endpoint (all three are required)
CODEEVO_LLM_BASE_URL=
CODEEVO_LLM_API_KEY=
CODEEVO_LLM_MODEL=
# Optional USD price snapshot used only when the provider omits response usage.cost.
CODEEVO_LLM_INPUT_COST_PER_MILLION=
CODEEVO_LLM_OUTPUT_COST_PER_MILLION=

# Replay evaluation and evolution activation gate
CODEEVO_EVAL_MAX_CASES=5
CODEEVO_EVAL_MIN_CASES=3
CODEEVO_EVAL_MIN_HOLDOUT_CASES=2
CODEEVO_EVAL_MIN_IMPROVEMENT=0.01
CODEEVO_EVAL_MAX_METRIC_REGRESSION=0
CODEEVO_EVAL_MAX_LATENCY_GROWTH_RATIO=0.25
CODEEVO_EVAL_MAX_TOKEN_GROWTH_RATIO=0.20
CODEEVO_EVAL_MAX_COST_GROWTH_RATIO=0.20

# GitHub integration
CODEEVO_GITHUB_WEBHOOK_SECRET=
CODEEVO_GITHUB_TOKEN=
CODEEVO_AUTO_POST_REVIEW=false
CODEEVO_WEBHOOK_MAX_AGE_SECONDS=600

# Production persistence and queue. Leave blank for SQLite/in-process mode.
CODEEVO_POSTGRES_PASSWORD=
CODEEVO_DATABASE_URL=
# Production can run `alembic upgrade head` separately and disable startup migration.
CODEEVO_DATABASE_AUTO_MIGRATE=true
CODEEVO_REDIS_URL=
CODEEVO_ASYNC_WORKERS=2
# Comma-separated proxy CIDRs. Leave empty unless traffic actually arrives from them.
CODEEVO_TRUSTED_PROXY_CIDRS=
CODEEVO_LOG_FORMAT=json
CODEEVO_LOG_LEVEL=INFO
# Read-only checkout root. Repositories resolve as <root>/<owner>/<repository>.
CODEEVO_REPOSITORY_ROOT=
CODEEVO_REPOSITORY_MAX_FILE_BYTES=262144
CODEEVO_REPOSITORY_MAX_FILES=2000
CODEEVO_REPOSITORY_MAX_INDEX_BYTES=20971520
CODEEVO_REPOSITORY_CONTEXT_LINES=4
CODEEVO_QUEUE_MAX_ATTEMPTS=3
CODEEVO_QUEUE_LEASE_SECONDS=60
CODEEVO_SKILLS_DIR=skills
CODEEVO_SKILL_SANDBOX=true
CODEEVO_SKILL_TIMEOUT_SECONDS=30
CODEEVO_SKILL_MEMORY_MB=256
CODEEVO_SKILL_SIGNING_KEY=

# Repair verification and observability
CODEEVO_REPAIR_TEST_COMMAND=
CODEEVO_REPAIR_VERIFY_TIMEOUT_SECONDS=120
CODEEVO_AGENT_MAX_WORKERS=4
CODEEVO_AGENT_RETRIES=1
CODEEVO_COLLABORATION_ROUNDS=2
CODEEVO_AGENT_LOOP_MAX_STEPS=4
CODEEVO_AGENT_LOOP_TIMEOUT_SECONDS=45
CODEEVO_CONTEXT_MAX_TOKENS=12000
CODEEVO_CONTEXT_RESERVED_TOKENS=2500
CODEEVO_MEMORY_ENABLED=true
CODEEVO_MEMORY_RECALL_LIMIT=6
CODEEVO_MEMORY_WORKING_TTL_SECONDS=86400
CODEEVO_OTEL_ENDPOINT=
CODEEVO_OTEL_SERVICE_NAME=codeevo
CODEEVO_ALERT_FAILURE_RATE=0.20
CODEEVO_ALERT_MIN_SAMPLES=10

# GitHub App (installation flow: /github/install, callback: /github/setup)
CODEEVO_GITHUB_APP_ID=
CODEEVO_GITHUB_APP_SLUG=
CODEEVO_GITHUB_PRIVATE_KEY_PATH=
CODEEVO_PUBLIC_BASE_URL=http://127.0.0.1:8080
